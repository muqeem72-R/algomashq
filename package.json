{
  "name": "algomashq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free platform to learn Data Structures and Algorithms by solving problems in C++, Java and Python.",
  "scripts": {
    "db:local": "wrangler d1 execute algomashq --local --file=db/schema.sql",
    "vendor": "npm --prefix tools/vendor install && node tools/vendor/build.mjs",
    "problems": "node tools/problems/build.mjs",
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "dev:java": "wrangler dev -c java/wrangler.toml --port 8789",
    "deploy:java": "wrangler deploy -c java/wrangler.toml",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
